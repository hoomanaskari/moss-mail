{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Moss",
  "version": "0.1.1",
  "identifier": "app.moss.mail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "sh scripts/app-icon.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moss",
        "width": 1440,
        "height": 1024,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 24, "y": 29 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Calm, keyboard-first email with private AI",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": { "Resources/Assets.car": "gen/icon/Assets.car" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRjdGQ0VGRDgxRTBCRTMKUldUakN4N1k3L3ozZkRSYUdpeUMweDcrbldFOEdGbG44YnI5eStmRG15VmJKMGJnWmtlYkZnN0QK",
      "endpoints": ["https://github.com/hoomanaskari/moss-mail/releases/latest/download/latest.json"]
    }
  }
}
