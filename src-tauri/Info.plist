<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The icon in Assets.car (from icons/Moss.icon, see scripts/app-icon.sh), whose light and
	     dark looks follow the Mac's appearance on macOS 26 and later. Older macOS uses
	     CFBundleIconFile, the icon.icns Tauri adds. -->
	<key>CFBundleIconName</key>
	<string>Moss</string>
	<!-- Moss opens mail links (mailto:), so macOS offers it as the default email app and sends
	     it the links other apps open. src-tauri/src/mail_links.rs takes them from there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Email Address URL</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mailto</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
